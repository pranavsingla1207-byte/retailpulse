table cohorts
	lineageTag: bdaee7de-43bd-4e29-9056-888f80787a40

	measure 'Retention %' =
			
			VAR CohortSize = CALCULATE(DISTINCTCOUNT(cohorts[customer_id]), cohorts[cohort_index] = 0)
			VAR ActiveCustomers = DISTINCTCOUNT(cohorts[customer_id])
			RETURN
			    DIVIDE(ActiveCustomers, CohortSize)
		formatString: 0%;-0%;0%
		lineageTag: 72bc8c83-fd31-4469-8928-e18849b7582e

	column invoice
		dataType: int64
		formatString: 0
		lineageTag: 649d5420-e77d-443f-bf62-606487c3c5ee
		summarizeBy: sum
		sourceColumn: invoice

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

