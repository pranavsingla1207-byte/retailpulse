	partition cohorts = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\Bada 2\retailpulse\data\processed\powerbi\cohorts.csv"),[Delimiter=",", Columns=11, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
