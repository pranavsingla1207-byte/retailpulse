{
  "name": "RetailPulse",
  "dataColors": [
    "#1B9AAA",
    "#06283D",
    "#EF7B45",
    "#6A994E",
    "#BC4749",
    "#457B9D",
    "#E9C46A",
    "#8D99AE",
    "#118AB2",
    "#073B4C"
  ],
  "foreground": "#06283D",
  "foregroundNeutralSecondary": "#3D5A6C",
  "foregroundNeutralTertiary": "#8DA2B0",
  "background": "#FFFFFF",
  "backgroundLight": "#F7F9FB",
  "backgroundNeutral": "#E3E8EF",
  "tableAccent": "#1B9AAA",
  "good": "#6A994E",
  "neutral": "#E9C46A",
  "bad": "#BC4749",
  "maximum": "#06283D",
  "center": "#8DA2B0",
  "minimum": "#DDF0F2",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#06283D"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#06283D"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#3D5A6C"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 40,
      "color": "#1B9AAA"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E3E8EF" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#06283D" } },
            "titleWrap": true
          }
        ]
      }
    }
  }
}
